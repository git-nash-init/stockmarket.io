rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true || 
              request.auth.token.email == 'financewithmehul@gmail.com');
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Blog posts - public read, admin write (matching your existing setup)
    match /blogs/{blogId} {
      allow read: if true; // Public can read blogs (as per your current rules)
      allow write: if isAdmin();
    }
    
    // Market data - authenticated read, admin write (matching your existing setup)
    match /marketData/{docId} {
      allow read: if isAuthenticated(); // Only authenticated users can read market data
      allow write: if isAdmin();
    }
    
    // Legacy market collection for backward compatibility
    match /market/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Admin collection (matching your existing setup)
    match /admins/{document} {
      allow read: if isAuthenticated();
      allow write: if false; // Only create admins manually
    }
    
    // Leads collection - allow creation by anyone (matching your existing setup)
    match /leads/{document} {
      allow read: if isAdmin(); // Only admin can read leads
      allow create: if true; // Anyone can submit leads from the website
      allow update, delete: if isAdmin();
    }
    
    // User profiles collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if isAdmin(); // Admin can manage all users
    }
    
    // Admin logs collection - Admin only
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
    
    // System configuration - Admin only  
    match /config/{configId} {
      allow read, write: if isAdmin();
    }
    
    // Default fallback - restrict everything else to admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
